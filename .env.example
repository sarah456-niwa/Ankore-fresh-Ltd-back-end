# Ankore Fresh backend .env example
# Copy this to .env and fill real values (do NOT commit secrets)

# Django secret key
SECRET_KEY=your-secret-key-here

# Site URL used in email links
SITE_URL=http://127.0.0.1:8000

# Email settings (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password-or-smtp-password
DEFAULT_FROM_EMAIL=no-reply@ankorefresh.com

# PostgreSQL (example)
DB_NAME=ankore_fresh_db
DB_USER=postgres
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432



# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here

# Database Settings
DB_NAME=ankore_fresh_db
DB_USER=postgres
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432

# Email Settings (Gmail - use your actual credentials)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=YOUR_EMAIL@gmail.com
EMAIL_HOST_PASSWORD=YOUR_16_DIGIT_APP_PASSWORD
DEFAULT_FROM_EMAIL=YOUR_EMAIL@gmail.com

# Site URL
SITE_URL=http://192.168.1.11:8000

# Admin Emails
ADMIN_EMAILS=admin@ankorefresh.com